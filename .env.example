# Copy to .env (gitignored) for end-to-end tests against the test accounts,
# set one of the two, and load it into the shell before running them:
#   set -a; . ./.env; set +a
#   go test -tags e2e -timeout 40m ./internal/e2e/
# Without either, the test is skipped. Never commit credentials.

# The key of the service account that reads the test tokens from Secret
# Manager (D158), as printed by script/live/google-setup.sh.
PIMVAULT_E2E_SERVICE_ACCOUNT=

# Or a local directory of e2e-gmail-token.json and e2e-outlook-token.json.
PIMVAULT_E2E_TOKENS=
