# The end-to-end test runs only in GitHub Actions (D199), never here. Cloud
# sessions use this for the weekly test sign-in (script/live/e2elogin) and
# live probes (script/live/tokens); the "goimapsync" cloud environment sets
# it. Copy to .env (gitignored) only to load it by hand:
#   set -a; . ./.env; set +a
# Never commit credentials.

# The key of the service account that reads the test tokens from Secret
# Manager (D158), as printed by script/live/google-setup.sh.
PIMVAULT_E2E_SERVICE_ACCOUNT=
