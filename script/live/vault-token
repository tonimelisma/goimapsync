#!/bin/sh
# Writes a Key Vault access token for the end-to-end test vault to stdout,
# for live probes and re-sign-in in a cloud session (D201, D202). It signs in
# with the client-credentials flow as the Entra ID app the cloud sessions
# share, whose client secret is the environment variable
# MELISMA_SECRETS_CLIENT_SECRET; the vault's own sign-in challenge names the
# tenant. The session-start hook exports the result as
# PIMVAULT_E2E_ACCESS_TOKEN; the token lasts about an hour, so a long session
# gets a fresh one with
#
#   export PIMVAULT_E2E_ACCESS_TOKEN="$(script/live/vault-token)"
#
# It refuses to write the token to a terminal and never prints the secret.
# The secret reaches curl on stdin, never on a command line.
#
# Exit status: 0 with the token on stdout; 3 when the secret is not set (not a
# cloud session); 1 when the vault or Entra ID cannot be reached or refuse,
# with the reason on stderr; 2 on misuse.
set -eu

# The cloud sessions' shared Entra ID app (cloud-sessions-reader). Not a
# secret; PIMVAULT_CLOUD_CLIENT_ID overrides it.
client_id=${PIMVAULT_CLOUD_CLIENT_ID:-5154d2ee-bdf5-49cf-8643-8918b3e8c32c}
vault=${PIMVAULT_E2E_KEY_VAULT:-kv-pimvault-ci}

if [ -z "${MELISMA_SECRETS_CLIENT_SECRET:-}" ]; then
  echo "vault-token: MELISMA_SECRETS_CLIENT_SECRET is not set (not a cloud session)" >&2
  exit 3
fi
if [ -t 1 ]; then
  # shellcheck disable=SC2016 # the command to type, not to expand
  echo 'vault-token: refusing to print a token to a terminal; use "$(script/live/vault-token)"' >&2
  exit 2
fi
case $vault in
  *[!A-Za-z0-9-]* | "") echo "vault-token: PIMVAULT_E2E_KEY_VAULT is not a vault name" >&2; exit 2 ;;
esac

# An unauthenticated request is answered with 401 and a challenge naming the
# vault's tenant: Bearer authorization="https://login.microsoftonline.com/<tenant>".
if ! headers=$(curl -sS -m 15 -o /dev/null -D - "https://$vault.vault.azure.net/secrets?api-version=7.4"); then
  echo "vault-token: cannot reach $vault.vault.azure.net (is it allowed in the environment's network settings?)" >&2
  exit 1
fi
tenant=$(printf '%s\n' "$headers" | tr -d '\r' |
  sed -n 's#^[Ww][Ww][Ww]-[Aa]uthenticate:.*authorization="https://[^/"]*/\([0-9A-Za-z.-]*\)".*#\1#p' | head -n 1)
if [ -z "$tenant" ]; then
  echo "vault-token: $vault.vault.azure.net sent no sign-in challenge naming its tenant" >&2
  exit 1
fi

# Entra ID's error response names the cause and holds no token.
if ! resp=$(printf '%s' "$MELISMA_SECRETS_CLIENT_SECRET" |
  curl -sS -m 20 --fail-with-body "https://login.microsoftonline.com/$tenant/oauth2/v2.0/token" \
    -d grant_type=client_credentials -d client_id="$client_id" \
    --data-urlencode client_secret@- \
    --data-urlencode scope=https://vault.azure.net/.default); then
  reason=$(printf '%s' "$resp" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("error_description", "").splitlines()[0])
except Exception: print("")' 2>/dev/null || true)
  echo "vault-token: Entra ID refused the sign-in: ${reason:-no reason given}" >&2
  exit 1
fi

printf '%s' "$resp" | python3 -c 'import json,sys
tok = json.load(sys.stdin).get("access_token", "")
if not tok:
    sys.exit("vault-token: Entra ID answered without an access token")
print(tok)'
